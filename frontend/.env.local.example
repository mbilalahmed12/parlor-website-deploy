# Supabase Configuration
# Get these values from your Supabase project dashboard (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=your_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Backend API URL (used by pages that load live settings/services)
NEXT_PUBLIC_API_URL=https://api.elegantedgeunisexsalon.in/api

# Set true for production/live content
NEXT_PUBLIC_ENABLE_LIVE_API=true

# Example (do not use these - replace with your actual values):
# NEXT_PUBLIC_SUPABASE_URL=https://abcdefgh.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Hostinger deployment notes: set the following environment variables via hPanel (Websites -> Manage -> Environment or App Settings)
# - NEXT_PUBLIC_SUPABASE_URL
# - NEXT_PUBLIC_SUPABASE_ANON_KEY
# - NEXT_PUBLIC_ENABLE_LIVE_API (true/false)
# - NEXT_PUBLIC_API_URL (optional — only if using the self-hosted API)
