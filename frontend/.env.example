# Public URL of the backend API
# Example local: http://localhost:5000/api
# Example production: https://api.your-domain.com/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Toggle live API/data loading in pages.
# Set to true in production builds.
NEXT_PUBLIC_ENABLE_LIVE_API=false

# Supabase (required for auth/storage/client data access)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
